# AWS Credentials & Bedrock Configuration (DO NOT COMMIT REAL KEYS TO GIT)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Default AWS Bedrock Models
BEDROCK_PRIMARY_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_FAST_MODEL_ID=meta.llama3-8b-instruct-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Local Vector DB & PyTorch Config
VECTOR_DB_DIR=./chroma_storage
TORCH_DEVICE=cpu
SPARK_APP_NAME=RAG-Lakehouse-Pipeline
